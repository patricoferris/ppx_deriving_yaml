type x =
  {
  age: int
    [@of_yamlx
      function
      | YAMLx.Int (_, f) -> Ok (Int64.to_int (let open Int64 in add f 10L))
      | _ -> Error (`Msg "Expected a Yaml `Float")]}[@@deriving yamlx]
include
  struct
    let x_to_yamlx (x : x) =
      Ppx_deriving_yamlx_runtime.obj
        (Stdlib.List.filter_map (fun x -> x)
           [Some
              ("age",
                (((fun (x : int) -> Ppx_deriving_yamlx_runtime.int x)) x.age))])
    let x_of_yamlx =
      let (>>=) v f = match v with | Ok v -> f v | Error _ as e -> e[@@warning
                                                                    "-26"] in
      function
      | YAMLx.Map (_, xs) ->
          let rec loop xs (arg0 as _state) =
            ((match xs with
              | (_, YAMLx.String (_, "age"), x)::xs ->
                  loop xs
                    ((function
                      | YAMLx.Int (_, f) ->
                          Ok (Int64.to_int (let open Int64 in add f 10L))
                      | _ -> Error (`Msg "Expected a Yaml `Float")) x)
              | [] -> arg0 >>= ((fun arg0 -> Ok { age = arg0 }))
              | (_, YAMLx.String (_, x), _)::_ ->
                  Error (`Msg ("Failed to find the case for: " ^ x))
              | _ -> Error (`Msg "Malformed key-value pairs"))
            [@warning "-11"]) in
          loop xs (Error (`Msg "Didn't find the function for key: age"))
      | _ ->
          Error (`Msg "Failed building a key-value object expecting a list")
  end[@@ocaml.doc "@inline"][@@merlin.hide ]
type arr = int array[@@deriving yamlx]
include
  struct
    let arr_to_yamlx x =
      Ppx_deriving_yamlx_runtime.list
        (Array.to_list
           (Array.map (fun (x : int) -> Ppx_deriving_yamlx_runtime.int x) x))
    let arr_of_yamlx =
      function
      | YAMLx.Seq (_, lst) ->
          let (>>=) v f = match v with | Ok v -> f v | Error _ as e -> e in
          ((fun f lst ->
              (Stdlib.List.fold_left
                 (fun acc x ->
                    match acc with
                    | Stdlib.Ok acc ->
                        (f x) >>= ((fun x -> Stdlib.Ok (x :: acc)))
                    | Stdlib.Error e -> Stdlib.Error e) (Stdlib.Ok []) lst)
                >>= (fun lst -> Stdlib.Ok (Stdlib.List.rev lst)))
             (function
              | YAMLx.Int (_, x) ->
                  Ok (Ppx_deriving_yamlx_runtime.of_integer x)
              | _ ->
                  Error (`Msg "Was expecting 'int' but got a different type"))
             lst)
            >>= ((fun lst -> Ok (Array.of_list lst)))
      | _ -> Error (`Msg "Was expecting 'array' but got a different type")
  end[@@ocaml.doc "@inline"][@@merlin.hide ]
