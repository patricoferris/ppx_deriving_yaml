type t = {
  name: string ;
  children: t list }[@@deriving yamlx]
include
  struct
    let rec to_yamlx (x : t) =
      Ppx_deriving_yamlx_runtime.obj
        (Stdlib.List.filter_map (fun x -> x)
           [Some
              ("name",
                (((fun (x : string) -> Ppx_deriving_yamlx_runtime.string x))
                   x.name));
           Some
             ("children",
               (((fun x ->
                    Ppx_deriving_yamlx_runtime.list
                      (List.map (fun x -> to_yamlx x) x))) x.children))])
    let rec of_yamlx =
      let (>>=) v f = match v with | Ok v -> f v | Error _ as e -> e[@@warning
                                                                    "-26"] in
      function
      | YAMLx.Map (_, xs) ->
          let rec loop xs ((arg0, arg1) as _state) =
            ((match xs with
              | (_, YAMLx.String (_, "name"), x)::xs ->
                  loop xs
                    (((function
                       | YAMLx.String (_, x) -> Ok x
                       | _ ->
                           Error
                             (`Msg
                                "Was expecting 'string' but got a different type"))
                        x), arg1)
              | (_, YAMLx.String (_, "children"), x)::xs ->
                  loop xs
                    (arg0,
                      ((function
                        | YAMLx.Seq (_, lst) ->
                            let (>>=) v f =
                              match v with | Ok v -> f v | Error _ as e -> e in
                            ((fun f lst ->
                                (Stdlib.List.fold_left
                                   (fun acc x ->
                                      match acc with
                                      | Stdlib.Ok acc ->
                                          (f x) >>=
                                            ((fun x -> Stdlib.Ok (x :: acc)))
                                      | Stdlib.Error e -> Stdlib.Error e)
                                   (Stdlib.Ok []) lst)
                                  >>=
                                  (fun lst -> Stdlib.Ok (Stdlib.List.rev lst))))
                              (fun x -> of_yamlx x) lst
                        | _ ->
                            Error
                              (`Msg
                                 "Was expecting 'list' but got a different type"))
                         x))
              | [] ->
                  arg1 >>=
                    ((fun arg1 ->
                        arg0 >>=
                          (fun arg0 -> Ok { name = arg0; children = arg1 })))
              | (_, YAMLx.String (_, x), _)::_ ->
                  Error (`Msg ("Failed to find the case for: " ^ x))
              | _ -> Error (`Msg "Malformed key-value pairs"))
            [@warning "-11"]) in
          loop xs
            ((Error (`Msg "Didn't find the function for key: name")),
              (Error (`Msg "Didn't find the function for key: children")))
      | _ ->
          Error (`Msg "Failed building a key-value object expecting a list")
  end[@@ocaml.doc "@inline"][@@merlin.hide ]
