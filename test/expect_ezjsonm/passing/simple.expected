type x =
  {
  age: int
    [@of_ezjsonm
      function
      | `Float f -> Ok (int_of_float (f +. 10.))
      | _ -> Error (`Msg "Expected a Yaml `Float")]}[@@deriving ezjsonm]
include
  struct
    let x_to_ezjsonm (x : x) =
      Ppx_deriving_ezjsonm_runtime.obj
        (Stdlib.List.filter_map (fun x -> x)
           [Some
              ("age",
                (((fun (x : int) -> Ppx_deriving_ezjsonm_runtime.int x))
                   x.age))])
    let x_of_ezjsonm =
      let (>>=) v f = match v with | Ok v -> f v | Error _ as e -> e[@@warning
                                                                    "-26"] in
      function
      | `O xs ->
          let rec loop xs (arg0 as _state) =
            ((match xs with
              | ("age", x)::xs ->
                  loop xs
                    ((function
                      | `Float f -> Ok (int_of_float (f +. 10.))
                      | _ -> Error (`Msg "Expected a Yaml `Float")) x)
              | [] -> arg0 >>= ((fun arg0 -> Ok { age = arg0 }))
              | (x, _)::_ ->
                  Error (`Msg ("Failed to find the case for: " ^ x))
              | _ -> Error (`Msg "Malformed key-value pairs"))
            [@warning "-11"]) in
          loop xs (Error (`Msg "Didn't find the function for key: age"))
      | _ ->
          Error (`Msg "Failed building a key-value object expecting a list")
  end[@@ocaml.doc "@inline"][@@merlin.hide ]
