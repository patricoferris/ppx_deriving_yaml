type var =
  | Hello 
  | World of string [@@deriving ezjsonm]
include
  struct
    let var_to_ezjsonm =
      function
      | Hello ->
          Ppx_deriving_ezjsonm_runtime.obj
            [("Hello", (Ppx_deriving_ezjsonm_runtime.list []))]
      | World arg0 ->
          Ppx_deriving_ezjsonm_runtime.obj
            [("World",
               (Ppx_deriving_ezjsonm_runtime.list
                  [((fun (x : string) ->
                       Ppx_deriving_ezjsonm_runtime.string x)) arg0]))]
    let var_of_ezjsonm =
      let (>>=) v f = match v with | Ok v -> f v | Error _ as e -> e[@@warning
                                                                    "-26"] in
      function
      | `O (("Hello", `A [])::[]) -> Stdlib.Result.Ok Hello
      | `O (("World", `A (arg0::[]))::[]) ->
          ((function
            | `String x -> Ok x
            | _ ->
                Error
                  (`Msg "Was expecting 'string' but got a different type"))
             arg0)
            >>= ((fun arg0 -> Stdlib.Result.Ok (World arg0)))
      | _ -> Stdlib.Error (`Msg "no match for this variant expression")
  end[@@ocaml.doc "@inline"][@@merlin.hide ]
type poly_var = [ `Hello  | `World of string ][@@deriving ezjsonm]
include
  struct
    let poly_var_to_ezjsonm =
      function
      | `Hello ->
          Ppx_deriving_ezjsonm_runtime.obj
            [("Hello", (Ppx_deriving_ezjsonm_runtime.list []))]
      | `World x ->
          ((fun (x : string) -> Ppx_deriving_ezjsonm_runtime.string x) x) |>
            ((fun x ->
                Ppx_deriving_ezjsonm_runtime.obj
                  [("World", (Ppx_deriving_ezjsonm_runtime.list [x]))]))
    let poly_var_of_ezjsonm =
      let (>>=) v f = match v with | Ok v -> f v | Error _ as e -> e[@@warning
                                                                    "-26"] in
      function
      | `O (("Hello", `A [])::[]) -> Stdlib.Result.Ok `Hello
      | `O (("World", `A (x::[]))::[]) ->
          ((function
            | `String x -> Ok x
            | _ ->
                Error
                  (`Msg "Was expecting 'string' but got a different type")) x)
            >>= ((fun x -> Stdlib.Result.Ok (`World x)))
      | _ -> Error (`Msg "failed converting variant")
  end[@@ocaml.doc "@inline"][@@merlin.hide ]
type a = {
  x: [ `Simple  | `Example ] }[@@deriving ezjsonm]
include
  struct
    let a_to_ezjsonm (x : a) =
      Ppx_deriving_ezjsonm_runtime.obj
        (Stdlib.List.filter_map (fun x -> x)
           [Some
              ("x",
                (((function
                   | `Simple ->
                       Ppx_deriving_ezjsonm_runtime.obj
                         [("Simple", (Ppx_deriving_ezjsonm_runtime.list []))]
                   | `Example ->
                       Ppx_deriving_ezjsonm_runtime.obj
                         [("Example", (Ppx_deriving_ezjsonm_runtime.list []))]))
                   x.x))])
    let a_of_ezjsonm =
      let (>>=) v f = match v with | Ok v -> f v | Error _ as e -> e[@@warning
                                                                    "-26"] in
      function
      | `O xs ->
          let rec loop xs (arg0 as _state) =
            ((match xs with
              | ("x", x)::xs ->
                  loop xs
                    ((let (>>=) v f =
                        match v with | Ok v -> f v | Error _ as e -> e
                        [@@warning "-26"] in
                      function
                      | `O (("Simple", `A [])::[]) ->
                          Stdlib.Result.Ok `Simple
                      | `O (("Example", `A [])::[]) ->
                          Stdlib.Result.Ok `Example
                      | _ -> Error (`Msg "failed converting variant")) x)
              | [] -> arg0 >>= ((fun arg0 -> Ok { x = arg0 }))
              | (x, _)::_ ->
                  Error (`Msg ("Failed to find the case for: " ^ x))
              | _ -> Error (`Msg "Malformed key-value pairs"))
            [@warning "-11"]) in
          loop xs (Error (`Msg "Didn't find the function for key: x"))
      | _ ->
          Error (`Msg "Failed building a key-value object expecting a list")
  end[@@ocaml.doc "@inline"][@@merlin.hide ]
type t = {
  name: string ;
  age: int option }[@@deriving ezjsonm]
include
  struct
    let to_ezjsonm (x : t) =
      Ppx_deriving_ezjsonm_runtime.obj
        (Stdlib.List.filter_map (fun x -> x)
           [Some
              ("name",
                (((fun (x : string) -> Ppx_deriving_ezjsonm_runtime.string x))
                   x.name));
           Some
             ("age",
               (((function
                  | None -> Ppx_deriving_ezjsonm_runtime.null
                  | Some t ->
                      ((fun (x : int) -> Ppx_deriving_ezjsonm_runtime.int x))
                        t)) x.age))])
    let of_ezjsonm =
      let (>>=) v f = match v with | Ok v -> f v | Error _ as e -> e[@@warning
                                                                    "-26"] in
      function
      | `O xs ->
          let rec loop xs ((arg0, arg1) as _state) =
            ((match xs with
              | ("name", x)::xs ->
                  loop xs
                    (((function
                       | `String x -> Ok x
                       | _ ->
                           Error
                             (`Msg
                                "Was expecting 'string' but got a different type"))
                        x), arg1)
              | ("age", x)::xs ->
                  loop xs
                    (arg0,
                      ((function
                        | `Null -> Ok None
                        | x ->
                            ((function
                              | `Float x ->
                                  Ok
                                    (Ppx_deriving_ezjsonm_runtime.of_integer
                                       x)
                              | _ ->
                                  Error
                                    (`Msg
                                       "Was expecting 'int' but got a different type"))
                               x)
                              >>= ((fun x -> Ok (Some x)))) x))
              | [] ->
                  arg1 >>=
                    ((fun arg1 ->
                        arg0 >>= (fun arg0 -> Ok { name = arg0; age = arg1 })))
              | (x, _)::_ ->
                  Error (`Msg ("Failed to find the case for: " ^ x))
              | _ -> Error (`Msg "Malformed key-value pairs"))
            [@warning "-11"]) in
          loop xs
            ((Error (`Msg "Didn't find the function for key: name")),
              (Ok None))
      | _ ->
          Error (`Msg "Failed building a key-value object expecting a list")
  end[@@ocaml.doc "@inline"][@@merlin.hide ]
type u = {
  name: string [@default "Una"]}[@@deriving to_ezjsonm]
include
  struct
    let u_to_ezjsonm (x : u) =
      Ppx_deriving_ezjsonm_runtime.obj
        (Stdlib.List.filter_map (fun x -> x)
           [((fun x ->
                if Stdlib.(=) x "Una"
                then None
                else
                  Some
                    ("name",
                      (((fun (x : string) ->
                           Ppx_deriving_ezjsonm_runtime.string x)) x))))
              x.name])
  end[@@ocaml.doc "@inline"][@@merlin.hide ]
type v = {
  age: int [@key "AGE"][@default 10]}[@@deriving of_ezjsonm]
include
  struct
    let v_of_ezjsonm =
      let (>>=) v f = match v with | Ok v -> f v | Error _ as e -> e[@@warning
                                                                    "-26"] in
      function
      | `O xs ->
          let rec loop xs (arg0 as _state) =
            ((match xs with
              | ("AGE", x)::xs ->
                  loop xs
                    ((function
                      | `Float x ->
                          Ok (Ppx_deriving_ezjsonm_runtime.of_integer x)
                      | _ ->
                          Error
                            (`Msg
                               "Was expecting 'int' but got a different type"))
                       x)
              | [] -> arg0 >>= ((fun arg0 -> Ok { age = arg0 }))
              | (x, _)::_ ->
                  Error (`Msg ("Failed to find the case for: " ^ x))
              | _ -> Error (`Msg "Malformed key-value pairs"))
            [@warning "-11"]) in
          loop xs (Ok 10)
      | _ ->
          Error (`Msg "Failed building a key-value object expecting a list")
  end[@@ocaml.doc "@inline"][@@merlin.hide ]
